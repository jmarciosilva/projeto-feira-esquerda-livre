APP_NAME="Feira Esquerda Livre"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco de dados
# Ambiente Docker: DB_HOST e o NOME DO SERVICO ("mysql"), nunca 127.0.0.1.
# Fora do Docker, troque DB_HOST para 127.0.0.1.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feira_esquerda_livre
DB_USERNAME=feira
DB_PASSWORD=feira_local
# Senha do root do MySQL local (usada pelo container e pelo phpMyAdmin).
DB_ROOT_PASSWORD=root_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# Redis
# Disponivel no ambiente Docker. CACHE_STORE e QUEUE_CONNECTION permanecem
# em "database": o Redis so passa a ser usado se essas chaves forem alteradas.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# -----------------------------------------------------------------------------
# E-mail (Mailpit no ambiente local: nenhum e-mail real e enviado)
# Interface web: http://localhost:8025
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@feiraesquerdalivre.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Portas publicadas no host pelo Docker Compose.
# Ajuste apenas se a porta ja estiver ocupada na sua maquina.
# As portas INTERNAS da rede Docker nunca mudam.
# -----------------------------------------------------------------------------
DOCKER_HTTP_PORT=80
DOCKER_MYSQL_PORT=3306
DOCKER_PHPMYADMIN_PORT=8081
DOCKER_REDIS_PORT=6380
DOCKER_VITE_PORT=5173
DOCKER_MAILPIT_HTTP_PORT=8025
DOCKER_MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# Integracoes externas (nunca versionar tokens reais)
# -----------------------------------------------------------------------------
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENVIRONMENT=sandbox

# JMF Customer Intelligence SDK
JMF_CI_BASE_URL=
JMF_CI_TOKEN=
JMF_CI_QUEUE_CONNECTION=sync
JMF_CI_TIMEOUT=2
