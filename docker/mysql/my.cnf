[mysqld]
# Charset padrao do projeto (migrations Laravel usam utf8mb4).
character-set-server         = utf8mb4
collation-server             = utf8mb4_unicode_ci

# Nao resolve DNS reverso dos containers: conexoes mais rapidas na rede Docker.
skip-name-resolve

max_allowed_packet           = 64M
innodb_buffer_pool_size      = 256M
innodb_flush_log_at_trx_commit = 2

# Timezone do servidor MySQL permanece o padrao (UTC) para nao alterar o
# comportamento atual de gravacao de datas da aplicacao.

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
